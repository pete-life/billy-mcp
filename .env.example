BILLY_ACCESS_TOKEN=
# Optional extra guard; discovered automatically from API token if omitted.
BILLY_ORGANIZATION_ID=
# Writes are disabled until explicitly enabled locally.
BILLY_ALLOW_WRITES=false
# Bank matching requires live contract verification before enabling.
BILLY_ALLOW_BANK_MATCHING=false
# Defaults to ~/.local/share/billy-mcp. Never commit this folder.
BILLY_DATA_DIR=
# Receipts must be copied/downloaded into this directory before import.
BILLY_RECEIPT_INBOX=
